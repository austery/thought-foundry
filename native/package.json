{
  "name": "thought-foundry-native-hugo",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node --import tsx src/cli.ts build",
    "preview": "node --import tsx src/serve.ts",
    "prepare-site": "node --import tsx src/cli.ts prepare",
    "restore": "node --import tsx src/cli.ts restore"
  },
  "dependencies": {
    "@sindresorhus/slugify": "2.2.1",
    "cheerio": "1.2.0",
    "gray-matter": "4.0.3",
    "liquidjs": "10.25.5",
    "pagefind": "1.5.2",
    "pinyin": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
