#-------------------------------------------------
# Retired output paths (prevent accidental recommits)
#-------------------------------------------------
# Historical generated site output
_site/

# Pagefind search index (generated during build)
_site/pagefind/

# Historical generated slug cache
.eleventy-cache.json

# Node.js dependencies
node_modules/
npm-debug.log
yarn-error.log

#-------------------------------------------------
# Operating System Files (macOS, Windows, Linux)
#-------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

#-------------------------------------------------
# Visual Studio Code Editor
#-------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

#-------------------------------------------------
# Legacy content-tool environments (not site dependencies)
#-------------------------------------------------
__pycache__/
.venv/
# Isolated comparison outputs
.benchmark/
.worktrees/
.native-*/
.backup-baseline-validation/
artifacts/native-previews/

# Local audit evidence and retained pre-cleanup documents
.local-evidence/
